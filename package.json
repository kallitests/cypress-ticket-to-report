{
  "name": "poc-smoke-tests-cicd",
  "version": "1.0.0",
  "description": "POC - Smoke tests & non-regression pipeline: Jira ticket to reporting, via Gherkin, Cypress, Docker, Kubernetes, GitHub Actions and Slack alerting. Target: saucedemo.com (UI) and reqres.in (API).",
  "scripts": {
    "cy:open": "cypress open",
    "test:smoke": "cypress run --env tags=@smoke",
    "test:regression": "cypress run --env tags=@regression",
    "test:all": "cypress run",
    "report:merge": "mochawesome-merge reports/mochawesome/*.json > reports/mochawesome/merged.json",
    "report:generate": "marge reports/mochawesome/merged.json -f report -o reports/mochawesome"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "cypress": "^13.13.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ]
  }
}
